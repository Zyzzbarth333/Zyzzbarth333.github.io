# Normalise text to LF
* text=auto eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf

# Binaries
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff2 binary
*.stl  binary
*.pdf  binary
*.mcap binary
*.glb binary
*.foxe binary
*.wasm binary
*.mp4 binary
*.webm binary
