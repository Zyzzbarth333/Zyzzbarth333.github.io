diff --git a/packages/suite-web/src/StaticSiteLoaders.ts b/packages/suite-web/src/StaticSiteLoaders.ts
new file mode 100644
index 0000000..ebdfaf7
--- /dev/null
+++ b/packages/suite-web/src/StaticSiteLoaders.ts
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: MPL-2.0
+
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/
+
+// Read-only extension and layout loaders for a static deployment. They read
+// `static/manifest.json`, next to index.html:
+//
+//   { "extensions": ["panels.foxe"], "layouts": [{ "name": "My layout", "file": "my-layout.json" }] }
+//
+// so a hosted copy can ship its own panels and layouts without a server or any
+// setup by the visitor. Without a manifest both loaders return nothing.
+
+import Log from "@lichtblick/log";
+import { LayoutData, LayoutLoader } from "@lichtblick/suite-base";
+import {
+  IExtensionLoader,
+  InstallExtensionProps,
+  LoadedExtension,
+  TypeExtensionLoader,
+} from "@lichtblick/suite-base/services/extension/IExtensionLoader";
+import { ALLOWED_FILES } from "@lichtblick/suite-base/services/extension/types";
+import decompressFile from "@lichtblick/suite-base/services/extension/utils/decompressFile";
+import extractFoxeFileContent from "@lichtblick/suite-base/services/extension/utils/extractFoxeFileContent";
+import validatePackageInfo from "@lichtblick/suite-base/services/extension/utils/validatePackageInfo";
+import { Namespace } from "@lichtblick/suite-base/types";
+import { ExtensionInfo } from "@lichtblick/suite-base/types/Extensions";
+import { LayoutInfo } from "@lichtblick/suite-base/types/layouts";
+
+const log = Log.getLogger(__filename);
+
+type Manifest = {
+  extensions?: string[];
+  layouts?: { name: string; file: string }[];
+};
+
+const BASE = new URL("static/", globalThis.location.href);
+let manifestPromise: Promise<Manifest> | undefined;
+
+async function manifest(): Promise<Manifest> {
+  manifestPromise ??= (async () => {
+    try {
+      const res = await fetch(new URL("manifest.json", BASE));
+      return res.ok ? ((await res.json()) as Manifest) : {};
+    } catch (err: unknown) {
+      log.debug("No static manifest", err);
+      return {};
+    }
+  })();
+  return await manifestPromise;
+}
+
+type Loaded = { info: ExtensionInfo; raw: string };
+
+export class StaticExtensionLoader implements IExtensionLoader {
+  public readonly namespace: Namespace = "local";
+  public readonly type: TypeExtensionLoader = "filesystem";
+  #loaded?: Promise<Map<string, Loaded>>;
+
+  async #all(): Promise<Map<string, Loaded>> {
+    this.#loaded ??= (async () => {
+      const out = new Map<string, Loaded>();
+      for (const file of (await manifest()).extensions ?? []) {
+        try {
+          const res = await fetch(new URL(file, BASE));
+          const data = await decompressFile(new Uint8Array(await res.arrayBuffer()));
+          const pkg = await extractFoxeFileContent(data, ALLOWED_FILES.PACKAGE);
+          const raw = await extractFoxeFileContent(data, ALLOWED_FILES.EXTENSION);
+          if (!pkg || !raw) {
+            throw new Error(`${file} is missing package.json or its entry point`);
+          }
+          const info = validatePackageInfo(JSON.parse(pkg) as Partial<ExtensionInfo>);
+          const publisher = info.publisher.replace(/[^A-Za-z0-9_\s]+/g, "");
+          const id = `${publisher}.${info.name}`;
+          out.set(id, {
+            raw,
+            info: {
+              ...info,
+              id,
+              namespace: this.namespace,
+              qualifiedName: info.displayName || info.name,
+              readme: (await extractFoxeFileContent(data, ALLOWED_FILES.README)) ?? "",
+              changelog: (await extractFoxeFileContent(data, ALLOWED_FILES.CHANGELOG)) ?? "",
+            },
+          });
+        } catch (err: unknown) {
+          log.error(`Failed to load static extension ${file}`, err);
+        }
+      }
+      return out;
+    })();
+    return await this.#loaded;
+  }
+
+  public async getExtension(id: string): Promise<ExtensionInfo | undefined> {
+    return (await this.#all()).get(id)?.info;
+  }
+
+  public async getExtensions(): Promise<ExtensionInfo[]> {
+    return [...(await this.#all()).values()].map(({ info }) => info);
+  }
+
+  public async loadExtension(id: string): Promise<LoadedExtension> {
+    const ext = (await this.#all()).get(id);
+    if (!ext) {
+      throw new Error("Extension not found");
+    }
+    return { raw: ext.raw };
+  }
+
+  public async installExtension(_props: InstallExtensionProps): Promise<ExtensionInfo> {
+    throw new Error("Static extensions are read-only");
+  }
+
+  public async uninstallExtension(_id: string): Promise<void> {
+    // Read-only: nothing to remove.
+  }
+}
+
+export class StaticLayoutLoader implements LayoutLoader {
+  public readonly namespace = "local";
+
+  public fetchLayouts = async (): Promise<LayoutInfo[]> => {
+    const out: LayoutInfo[] = [];
+    for (const { name, file } of (await manifest()).layouts ?? []) {
+      try {
+        const res = await fetch(new URL(file, BASE));
+        out.push({ from: `static/${file}`, name, data: (await res.json()) as LayoutData });
+      } catch (err: unknown) {
+        log.error(`Failed to load static layout ${file}`, err);
+      }
+    }
+    return out;
+  };
+}
